# @BotFather token — never commit .env
TELEGRAM_TOKEN=

# Fine-grained PAT: Issues Read and write on one repo
GITHUB_TOKEN=

# owner/repo
GITHUB_REPO=ryzhaknode/sportapp

# Random string for pseudonymous reporter tags (tg-xxxxxxxx)
REPORTER_SALT=

# Optional whitelist: comma-separated Telegram user IDs; empty = allow everyone
ALLOWED_USER_IDS=

# Optional kill switch (/stop, /resume, /pipeline). SEPARATE fine-grained PAT from GITHUB_TOKEN:
# this repo only, Variables: Read and write, Actions: Read and write
GH_ADMIN_TOKEN=
# Comma-separated Telegram user IDs allowed to use the kill switch (/myid shows yours)
ADMIN_USER_IDS=
